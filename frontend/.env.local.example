# Copy this file to .env.local and fill in your Azure credentials
# This file is for LOCAL DEVELOPMENT ONLY and should not be committed to git

# === AZURE BLOB STORAGE CONFIGURATION ===
# Required for file uploads to work

# Get these from Azure Portal:
# 1. Storage Account → Security + networking → Access keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=

# 2. Storage Account → Overview → Storage account name
AZURE_STORAGE_ACCOUNT_NAME=

# 3. Storage Account → Security + networking → Access keys → Key
AZURE_STORAGE_ACCOUNT_KEY=

# Container name (must match what you created in Azure)
AZURE_CONTAINER_NAME=resumes

