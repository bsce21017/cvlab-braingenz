# ===========================================
# CVLab Backend Production Environment
# ===========================================
# Copy this file to .env.production and fill in the values

# API Keys (Required)
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx

# Database (Supabase PostgreSQL)
# Use the Session Pooler connection string from Supabase for IPv4 compatibility
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Redis (Internal Docker network)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Supabase (Required for Auth and Admin)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx

# AWS S3 (Required for File Storage)
AWS_ACCESS_KEY_ID=AKIAxxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=me-central-1
S3_BUCKET=file-upload-cvai

# App Settings
DEBUG=False
APP_HOST=0.0.0.0
APP_PORT=8002

# LLM Settings
DEFAULT_LLM_PROVIDER=claude
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o
MAX_TOKENS=8000

# Session
SESSION_TIMEOUT_MINUTES=30

# LangGraph
USE_LANGGRAPH=true

# ===========================================
# Admin Credentials (set during first deploy)
# ===========================================
# Email: admin@cvlab.sa
# Password: Admin@CVLab2024!
# ===========================================
